rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(userId) {
      let data = request.resource.data;
      let garage = data.garage;
      let upgrades = garage.upgrades;
      return data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'bestScore', 'money', 'garage'])
        && data.keys().hasAll(['uid', 'displayName', 'photoURL', 'bestScore', 'money', 'garage'])
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() <= 40
        && (data.photoURL == null || data.photoURL is string)
        && data.bestScore is int
        && data.bestScore >= 0
        && data.bestScore <= 100000000
        && data.money is int
        && data.money >= 0
        && data.money <= 1000000000
        && garage is map
        && garage.keys().hasOnly(['upgrades', 'ownedSkins', 'equippedSkin'])
        && garage.keys().hasAll(['upgrades', 'ownedSkins', 'equippedSkin'])
        && upgrades is map
        && upgrades.keys().hasOnly(['speed', 'boost', 'chaser'])
        && upgrades.keys().hasAll(['speed', 'boost', 'chaser'])
        && upgrades.speed is int && upgrades.speed >= 0 && upgrades.speed <= 5
        && upgrades.boost is int && upgrades.boost >= 0 && upgrades.boost <= 5
        && upgrades.chaser is int && upgrades.chaser >= 0 && upgrades.chaser <= 3
        && garage.ownedSkins is list
        && garage.ownedSkins.size() <= 2
        && garage.ownedSkins.hasOnly([0, 1])
        && garage.equippedSkin is int
        && (garage.equippedSkin == -1 || garage.ownedSkins.hasAny([garage.equippedSkin]));
    }

    function matchingPlayer(userId) {
      let player = getAfter(/databases/$(database)/documents/players/$(userId)).data;
      return request.resource.data.displayName == player.displayName
        && request.resource.data.bestScore == player.bestScore;
    }

    match /players/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId) && validProfile(userId);
      allow update: if signedInAs(userId)
        && validProfile(userId)
        && request.resource.data.bestScore >= resource.data.bestScore;
      allow delete: if false;

      match /completedRuns/{runId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.keys().hasOnly(['score', 'moneyEarned'])
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100000000
          && request.resource.data.moneyEarned is int
          && request.resource.data.moneyEarned >= 0
          && request.resource.data.moneyEarned <= 1000;
        allow update, delete: if false;
      }
    }

    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'bestScore'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 100000000
        && matchingPlayer(userId);
      allow update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'bestScore'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data.bestScore <= 100000000
        && matchingPlayer(userId);
      allow delete: if false;
    }
  }
}
